---
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-blanco-aqua.png';
import { BRAND, CONTACT, NAV_LINKS, SOCIAL_LINKS, WHATSAPP_NUMBER } from '../lib/constants';
import { whatsappLink } from '../lib/loan';
import { withBase } from '../lib/url';

const whatsappHref = whatsappLink(WHATSAPP_NUMBER, 'Hola, tengo una pregunta sobre Convalor.');

const socialIcons: Record<string, string> = {
  facebook: 'M13 9h3V6h-3c-1.7 0-3 1.3-3 3v2H8v3h2v7h3v-7h2.5l.5-3H13V9.5c0-.3.2-.5.5-.5Z',
  instagram:
    'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Z M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M17 6.8h.01',
  linkedin:
    'M4 4h16v16H4V4Z M8 10v7 M8 7v.01 M12 17v-4a2 2 0 0 1 4 0v4 M12 13v4',
};
---

<footer id="contacto" class="bg-navy text-white">
  <div class="mx-auto max-w-content px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <Image src={logo} alt="Convalor" class="h-8 w-auto" widths={[160]} sizes="140px" />
        <p class="mt-4 max-w-xs text-sm text-white/70">{BRAND.tagline}</p>

        <div class="mt-6 flex items-center gap-3">
          {
            SOCIAL_LINKS.map((social) => (
              <a
                href={social.href}
                aria-label={social.label}
                class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/70 transition hover:border-aqua-500 hover:text-aqua-300"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={socialIcons[social.icon]} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-white/50">Navegación</p>
        <ul class="mt-4 space-y-2.5">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/75 transition hover:text-aqua-300">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-white/50">Contacto</p>
        <ul class="mt-4 space-y-2.5 text-sm text-white/75">
          <li>{CONTACT.address}</li>
          <li>
            <a href={`mailto:${CONTACT.email}`} class="transition hover:text-aqua-300">
              {CONTACT.email}
            </a>
          </li>
          <li>
            <a href={whatsappHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition hover:text-aqua-300">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.83 14.11c-.25.7-1.25 1.29-2.03 1.45-.54.11-1.24.2-3.6-.77-3.02-1.25-4.97-4.31-5.12-4.51-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.05-2.49.28-.3.6-.37.8-.37.2 0 .4 0 .58.01.19.01.44-.07.68.53.25.6.85 2.07.92 2.22.07.15.12.33.02.53-.1.2-.15.32-.3.49-.15.17-.31.38-.45.51-.15.15-.3.3-.13.6.17.3.76 1.26 1.64 2.04 1.13 1 2.08 1.32 2.38 1.47.3.15.48.13.65-.08.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.28.1 1.77.84 2.07.99.3.15.5.22.58.35.07.13.07.75-.18 1.45Z" />
              </svg>
              WhatsApp
            </a>
          </li>
          <li>
            <a href={withBase('aviso-de-privacidad')} class="transition hover:text-aqua-300">
              Aviso de privacidad
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 border-t border-white/10 pt-8 text-sm text-white/50">
      {BRAND.name} · {BRAND.city}
    </div>
  </div>
</footer>
