---
import { WHATSAPP_NUMBER } from '../lib/constants';
import { whatsappLink } from '../lib/loan';

const testimonios = [
  'Necesitaba capital para mi negocio y no quería esperar meses. Con Convalor, en dos días ya tenía respuesta.',
  'Resolví una urgencia sin poner en riesgo lo que más me costó construir.',
];

const href = whatsappLink(WHATSAPP_NUMBER, 'Hola, quiero conocer más casos de éxito de Convalor.');
---

<section class="bg-white py-24 sm:py-28">
  <div class="mx-auto max-w-content px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="kicker justify-center">04 · Voces reales</p>
      <h2 class="mt-4 font-heading text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Historias, no promesas
      </h2>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        testimonios.map((quote) => (
          <blockquote class="relative rounded-2xl bg-mist-100 p-8">
            <svg class="h-8 w-8 text-aqua-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.17 6C4.87 8 3.5 10.9 3.5 14c0 3 2 5 4.5 5 2.2 0 4-1.8 4-4 0-2-1.4-3.6-3.3-3.9.4-1.7 1.7-3.2 3.3-4.1L7.17 6Zm10 0c-2.3 2-3.67 4.9-3.67 8 0 3 2 5 4.5 5 2.2 0 4-1.8 4-4 0-2-1.4-3.6-3.3-3.9.4-1.7 1.7-3.2 3.3-4.1L17.17 6Z" />
            </svg>
            <p class="mt-4 text-lg leading-relaxed text-ink">{quote}</p>
          </blockquote>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a href={href} target="_blank" rel="noopener" class="btn-ghost">
        Conoce más casos
      </a>
    </div>
  </div>
</section>
